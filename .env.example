# Copy this file to .env and fill in what you use. The workbench reads .env from the
# directory you launch it in. One provider is enough to start.

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# OpenAI: text, plus native image generation and text-to-speech.
OPENAI_API_KEY=

# Gemini, via Google's OpenAI-compatibility endpoint (text only).
# GOOGLE_API_KEY also works if you already have one set.
GEMINI_API_KEY=

# HuggingFace: text, image and sound.
# HF_TOKEN is the name HuggingFace's own libraries read; HUGGINGFACE_HUB_KEY also works.
HF_TOKEN=

# Ollama Cloud
OLLAMA_API_KEY=

# Your own Ollama box ("ollama-local"). Leave commented out if you don't run one.
# LOCAL_OLLAMA_URL=http://localhost:11434

# --- Optional ---
# Your own model catalog, merged over the built-in one by model id.
# CORBELITY_MODEL_CATALOG=./my-models.json

# Show only these services in the model dropdown. Presentation only -- it does not
# disable a service, and a filtered-out model still runs if something asks for it.
# CORBELITY_SERVICES=openai,ollama-local

# Record every call (full prompts and responses!) to logs/traces.jsonl. Off by default.
# TRACE_ENABLED=1
# TRACE_FILE=logs/traces.jsonl

# DEBUG, INFO (default), WARNING, ERROR
# LOGGING_LEVEL=INFO

# Stop the browser caching style.css and app.js while you edit the UI.
# --reload sets this for you; only needed if you run uvicorn directly.
# WORKBENCH_DEV=1